#!/usr/bin/env bash
# claude-multi-desktop: run several Claude Desktop accounts side by side on one Mac.
# Every account keeps its own sign-in and chats; Claude Code in every account shares one ~/.claude.
# https://github.com/jackson-cmd/claude-multi-desktop  ·  MIT License  ·  not affiliated with Anthropic
set -euo pipefail

VERSION="0.1.3"
SUPPORT="$HOME/Library/Application Support"
APPS_DIR="${CMD_APPS_DIR:-$HOME/Applications}"
CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
MARKER="# claude-multi-desktop launcher"
PALETTE=(3B6FD8 2E9D6A 7A5AE0 1F9AA8 D2504B C98A12 C8508A 5C6470)
PLISTBUDDY=/usr/libexec/PlistBuddy

die() { printf 'claude-multi-desktop: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

usage() {
  cat <<'EOF'
claude-multi-desktop: run several Claude Desktop accounts side by side on one Mac.

Usage:
  claude-multi-desktop add NAME [--icon ICON] [--color HEX]
                                    Make a launcher "Claude NAME" with its own sign-in
  claude-multi-desktop add NAME --default
                                    Make a launcher for the account you already use
  claude-multi-desktop icon NAME [--icon ICON] [--color HEX]
                                    Give a launcher a new icon or colour
  claude-multi-desktop rename NAME NEW
                                    Rename a launcher; its sign-in and chats stay
  claude-multi-desktop list         Show your launchers and which are open
  claude-multi-desktop open NAME    Open that account's window
  claude-multi-desktop quit NAME... | --all
                                    Quit Claude in those accounts, or in every account (do this
                                    before you update Claude Desktop)
  claude-multi-desktop doctor [--fix]
                                    Check every launcher; --fix repairs launchers whose Claude.app
                                    has moved, and finds account folders that lost their launcher
  claude-multi-desktop peers        Show Claude Code sessions running in every account
  claude-multi-desktop remove NAME [--delete-data]
  claude-multi-desktop version | help

ICON is one of:
  letter          a coloured square with the first letter of the name (the default)
  claude          your own Claude icon with a coloured letter badge, drawn on this Mac
  /path/to/image  any picture (PNG, JPEG, HEIC, ICNS, ...)

Launchers go to ~/Applications (set CMD_APPS_DIR to change it). Each new account keeps its
sign-in and chats in ~/Library/Application Support/Claude-NAME. Claude Code in every account
reads the same ~/.claude, so skills, CLAUDE.md, memory and MCP servers are shared and sessions
in different accounts can message each other.

Unofficial; not affiliated with Anthropic. For legitimate use only, with accounts you are entitled
to use. Do not use it to get around usage limits or to share accounts.
EOF
}

is_claude() { [ -n "$1" ] && [ -x "$1/Contents/MacOS/Claude" ]; }

find_claude() {
  local p
  for p in "${CLAUDE_APP:-}" "/Applications/Claude.app" "$HOME/Applications/Claude.app"; do
    if is_claude "$p"; then printf '%s' "$p"; return 0; fi
  done
  return 1
}

check_name() {
  local n="$1"
  [[ "$n" =~ ^[A-Za-z0-9][A-Za-z0-9\ _-]{0,29}$ ]] ||
    die "name must be 1-30 letters, digits, spaces, '-' or '_', starting with a letter or digit: '$n'"
  [[ ! "$n" =~ [-\ ]?3[pP]$ ]] || die "names ending in '3p' clash with folders Claude Desktop creates itself"
  [[ "$n" != *" " ]] || die "name must not end with a space"
}

app_path() { printf '%s/Claude %s.app' "$APPS_DIR" "$1"; }
slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/-*$//'; }

# Folder (under ~/Library/Application Support) that a launcher points at, read from the launcher itself.
# launcher_dir_expr gives it as written, with a literal $HOME; launcher_dir expands that.
launcher_dir_expr() {
  local line
  line="$(grep -o 'user-data-dir="[^"]*"' "$1/Contents/MacOS/launcher" 2>/dev/null | head -1)" || return 1
  line="${line#user-data-dir=\"}"; printf '%s' "${line%\"}"
}
launcher_dir() { local e; e="$(launcher_dir_expr "$1")" || return 1; printf '%s' "${e/\$HOME/$HOME}"; }

launcher_target() { # the Claude.app a launcher opens
  local line
  line="$(grep -o 'open -n -a "[^"]*"' "$1/Contents/MacOS/launcher" 2>/dev/null | head -1)" || return 1
  line="${line#open -n -a \"}"; printf '%s' "${line%\"}"
}

write_launcher() { # APP CLAUDE.APP DIR-EXPRESSION (with a literal $HOME, expanded when the launcher runs)
  cat > "$1/Contents/MacOS/launcher" <<EOF
#!/bin/bash
$MARKER (https://github.com/jackson-cmd/claude-multi-desktop)
exec open -n -a "$2" --args --user-data-dir="$3"
EOF
  chmod +x "$1/Contents/MacOS/launcher"
}

re_escape() { printf '%s' "$1" | sed 's/[][\.*^$+?(){}|]/\\&/g'; }

# PIDs of the Claude main process that runs with this account folder, one per line. Its helper processes
# (renderer, GPU and so on) are left out: asking the main process to quit closes them too.
account_pids() {
  local procs esc app
  procs="$(ps -axo pid=,command= 2>/dev/null || true)"
  procs="$(grep -F '/Contents/MacOS/Claude' <<< "$procs" | grep -vF -e 'Claude Helper' -e ' --type=' || true)"
  [ -n "$procs" ] || return 0
  esc="$(re_escape "$1")"
  {
    grep -E -- "/Contents/MacOS/Claude .*--user-data-dir=${esc}( |\$)" <<< "$procs" || true
    # The default account also runs when Claude.app is opened the normal way, with no flag at all.
    if [ "$1" = "$SUPPORT/Claude" ]; then
      if app="$(find_claude)"; then esc="$(re_escape "$app")"; else esc='[^ ]*/Claude\.app'; fi
      grep -E -- "^ *[0-9]+ (.* )?${esc}/Contents/MacOS/Claude( -psn_[0-9_]+)?\$" <<< "$procs" || true
    fi
  } | awk '{ print $1 }' | sort -un
}

is_open() { [ -n "$(account_pids "$1")" ]; } # true when Claude runs with this account folder

still_running() { # "PID PID ..." -> prints those that have not ended (a finished process waiting to be reaped counts as ended)
  [ -n "${1// /}" ] || return 0
  ps -o pid=,stat= -p "$(printf '%s' "$1" | tr -s ' ' ',' | sed 's/^,//; s/,$//')" 2>/dev/null | awk '$2 !~ /^Z/ { print $1 }'
}

# Draw the launcher icon. STYLE is letter, claude or image; SRC is Claude.app (claude) or the picture (image).
# Only the picture you choose or the Claude.app on this Mac is read; this tool ships no Anthropic artwork.
make_icon() { # STYLE LETTER HEX OUT.icns [SRC]
  local tmp; tmp="$(mktemp -d)"
  osascript -l JavaScript - "$1" "$2" "$3" "$tmp/icon.png" "${5:-}" >/dev/null 2>&1 <<'JXA' || true
ObjC.import('AppKit');
function run(argv) {
  const style = argv[0], letter = argv[1], n = parseInt(argv[2], 16), out = argv[3], src = argv[4], size = 1024;
  const color = $.NSColor.colorWithSRGBRedGreenBlueAlpha(((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255, 1);
  let picture = null;
  if (style === 'claude') picture = $.NSWorkspace.sharedWorkspace.iconForFile(src);
  if (style === 'image') picture = $.NSImage.alloc.initWithContentsOfFile(src);
  if (style !== 'letter' && (!picture || picture.isNil() || picture.size.width <= 0)) return;
  const rep = $.NSBitmapImageRep.alloc.initWithBitmapDataPlanesPixelsWidePixelsHighBitsPerSampleSamplesPerPixelHasAlphaIsPlanarColorSpaceNameBytesPerRowBitsPerPixel(
    null, size, size, 8, 4, true, false, $.NSDeviceRGBColorSpace, 0, 0);
  $.NSGraphicsContext.saveGraphicsState;
  $.NSGraphicsContext.setCurrentContext($.NSGraphicsContext.graphicsContextWithBitmapImageRep(rep));
  const drawLetter = (fontSize, cx, cy) => {
    const attrs = $.NSMutableDictionary.dictionary;
    attrs.setObjectForKey($.NSFont.boldSystemFontOfSize(fontSize), $('NSFont'));
    attrs.setObjectForKey($.NSColor.whiteColor, $('NSColor'));
    const s = $.NSString.alloc.initWithString(letter), sz = s.sizeWithAttributes(attrs);
    s.drawAtPointWithAttributes($.NSMakePoint(cx - sz.width / 2, cy - sz.height / 2), attrs);
  };
  if (style === 'letter') {
    color.setFill;
    $.NSBezierPath.bezierPathWithRoundedRectXRadiusYRadius($.NSMakeRect(100, 100, 824, 824), 185, 185).fill;
    drawLetter(500, size / 2, size / 2);
  } else {
    const w = picture.size.width, h = picture.size.height, scale = (style === 'claude' ? size : 824) / Math.max(w, h);
    const dw = w * scale, dh = h * scale;
    picture.drawInRectFromRectOperationFraction($.NSMakeRect((size - dw) / 2, (size - dh) / 2, dw, dh), $.NSMakeRect(0, 0, 0, 0), 2, 1);
    if (style === 'claude') { // a letter badge in the lower right corner, so each account is easy to tell apart
      $.NSColor.whiteColor.setFill;
      $.NSBezierPath.bezierPathWithOvalInRect($.NSMakeRect(566, 46, 420, 420)).fill;
      color.setFill;
      $.NSBezierPath.bezierPathWithOvalInRect($.NSMakeRect(588, 68, 376, 376)).fill;
      drawLetter(250, 776, 256);
    }
  }
  $.NSGraphicsContext.restoreGraphicsState;
  rep.representationUsingTypeProperties(4 /* PNG */, $()).writeToFileAtomically(out, true);
}
JXA
  if [ -s "$tmp/icon.png" ]; then
    local sz; mkdir -p "$tmp/icon.iconset"
    for sz in 16 32 128 256 512; do
      sips -z "$sz" "$sz" "$tmp/icon.png" --out "$tmp/icon.iconset/icon_${sz}x${sz}.png" >/dev/null 2>&1 || true
      sips -z $((sz * 2)) $((sz * 2)) "$tmp/icon.png" --out "$tmp/icon.iconset/icon_${sz}x${sz}@2x.png" >/dev/null 2>&1 || true
    done
    iconutil -c icns "$tmp/icon.iconset" -o "$4" >/dev/null 2>&1 || true
  fi
  rm -rf "$tmp"
  [ -s "$4" ]
}

default_color() { local i; i=$(( $(printf '%s' "$1" | cksum | cut -d' ' -f1) % ${#PALETTE[@]} )); printf '%s' "${PALETTE[$i]}"; }

# --icon VALUE -> "STYLE<TAB>PICTURE"; a picture is checked before anything is created.
parse_icon() {
  case "$1" in
    letter|claude) printf '%s\t' "$1" ;;
    "") die "--icon takes letter, claude or the path of a picture" ;;
    *)
      local pic="${1/#\~/$HOME}"
      [ -f "$pic" ] || die "--icon: no such picture '$1' (or use letter or claude)"
      local size; size="$(sips -g pixelWidth "$pic" 2>/dev/null)" || true   # in $(), so a crash of sips stays quiet
      [[ "$size" == *"pixelWidth: "[0-9]* ]] || die "--icon: '$1' is not a picture macOS can read"
      pic="$(cd "$(dirname "$pic")" && pwd)/$(basename "$pic")"
      printf 'image\t%s' "$pic" ;;
  esac
}

check_color() { [[ "$1" =~ ^[0-9A-Fa-f]{6}$ ]] || die "--color takes a hex colour such as 3B6FD8"; }

write_plist() { # APP NAME STYLE COLOR
  cat > "$1/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Claude $2</string>
  <key>CFBundleDisplayName</key><string>Claude $2</string>
  <key>CFBundleIdentifier</key><string>local.claude-multi-desktop.$(slug "$2")</string>
  <key>CFBundleExecutable</key><string>launcher</string>
  <key>CFBundleIconFile</key><string>icon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$VERSION</string>
  <key>CFBundleVersion</key><string>$VERSION</string>
  <key>LSUIElement</key><true/>
  <key>ClaudeMultiDesktopIcon</key><string>$3</string>
  <key>ClaudeMultiDesktopColor</key><string>$4</string>
</dict>
</plist>
EOF
}

plist_get() { "$PLISTBUDDY" -c "Print :$2" "$1/Contents/Info.plist" 2>/dev/null || true; }

draw_icon() { # APP NAME STYLE COLOR [PICTURE]; prints a note when no icon could be drawn
  local letter src="${5:-}"
  letter="$(printf '%s' "$2" | cut -c1 | tr '[:lower:]' '[:upper:]')"
  if [ "$3" = claude ]; then src="$(find_claude)" || { say "note: Claude.app not found, so the icon is a coloured letter"; draw_icon "$1" "$2" letter "$4"; return; }; fi
  rm -f "$1/Contents/Resources/icon.icns"
  make_icon "$3" "$letter" "$4" "$1/Contents/Resources/icon.icns" "$src" || say "note: could not draw an icon; the launcher works without one"
}

refresh_app() { # tell Finder, Launchpad and the Dock that the launcher changed
  local lsreg=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
  touch "$1"
  [ -x "$lsreg" ] && "$lsreg" -f "$1" >/dev/null 2>&1 || true
}

is_ours() { [ -f "$1/Contents/MacOS/launcher" ] && grep -qF "$MARKER" "$1/Contents/MacOS/launcher"; }

cmd_add() {
  local name="" default=0 color="" icon="letter" pic=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --default) default=1 ;;
      --color) shift; color="${1:-}" ;;
      --icon) shift; IFS=$'\t' read -r icon pic < <(parse_icon "${1:-}"; printf '\n') ;;
      -h|--help) usage; return 0 ;;
      -*) die "unknown option: $1" ;;
      *) [ -z "$name" ] || die "one name at a time (quote names with spaces)"; name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || die "usage: claude-multi-desktop add NAME [--default] [--icon ICON] [--color HEX]"
  check_name "$name"
  [ -n "$icon" ] || exit 1
  local claude; claude="$(find_claude)" || die "Claude.app not found in /Applications or ~/Applications (set CLAUDE_APP=/path/to/Claude.app)"
  color="${color#\#}"
  [ -n "$color" ] || color="$(default_color "$name")"
  check_color "$color"

  local app dir_expr dir
  app="$(app_path "$name")"
  [ ! -e "$app" ] || die "'$app' already exists (remove it first)"
  # shellcheck disable=SC2016  # $HOME is written into the launcher literally and expands when it runs
  if [ "$default" = 1 ]; then dir_expr='$HOME/Library/Application Support/Claude'
  else dir_expr="\$HOME/Library/Application Support/Claude-$name"; fi
  dir="${dir_expr/\$HOME/$HOME}"
  local other
  for other in "$APPS_DIR"/Claude\ *.app; do
    [ -e "$other" ] || continue
    if [ "$(launcher_dir "$other" || true)" = "$dir" ]; then die "'$other' already opens that account"; fi
  done

  mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
  write_launcher "$app" "$claude" "$dir_expr"
  write_plist "$app" "$name" "$icon" "$color"
  draw_icon "$app" "$name" "$icon" "$color" "$pic"
  refresh_app "$app"

  say "Created  $app"
  say "Account  $dir"
  if [ "$default" = 1 ]; then
    say "This launcher opens the account you already use, even while other accounts are open."
  else
    say "Next: claude-multi-desktop open \"$name\"   (or double-click it) and sign in with the other account."
  fi
}

# Style and colour a launcher was made with; launchers from 0.1.0 have neither recorded, so use what 0.1.0 drew.
icon_settings() { # APP NAME -> "STYLE<TAB>COLOR"
  local style color
  style="$(plist_get "$1" ClaudeMultiDesktopIcon)"; color="$(plist_get "$1" ClaudeMultiDesktopColor)"
  printf '%s\t%s' "${style:-letter}" "${color:-$(default_color "$2")}"
}

cmd_icon() {
  local name="" icon="" pic="" color=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --color) shift; color="${1:-}" ;;
      --icon) shift; IFS=$'\t' read -r icon pic < <(parse_icon "${1:-}"; printf '\n'); [ -n "$icon" ] || exit 1 ;;
      -*) die "unknown option: $1" ;;
      *) [ -z "$name" ] || die "one name at a time (quote names with spaces)"; name="$1" ;;
    esac
    shift
  done
  if [ -z "$name" ] || { [ -z "$icon" ] && [ -z "$color" ]; }; then
    die "usage: claude-multi-desktop icon NAME [--icon letter|claude|/path/to/image] [--color HEX]"
  fi
  local app old_style old_color; app="$(app_path "$name")"
  is_ours "$app" || die "no launcher made by this tool at '$app'"
  IFS=$'\t' read -r old_style old_color < <(icon_settings "$app" "$name"; printf '\n')
  color="${color#\#}"; [ -z "$color" ] || check_color "$color"
  if [ -z "$icon" ]; then
    [ "$old_style" != image ] || die "a picture icon has no colour; use --icon letter or --icon claude with --color"
    icon="$old_style"
  fi
  write_plist "$app" "$name" "$icon" "${color:-$old_color}"
  draw_icon "$app" "$name" "$icon" "${color:-$old_color}" "$pic"
  refresh_app "$app"
  say "New icon for $app"
  say "If the Dock still shows the old one, remove the launcher from the Dock and drag it back."
}

cmd_rename() {
  [ $# -eq 2 ] || die "usage: claude-multi-desktop rename NAME NEW-NAME"
  local old="$1" new="$2" from to style color dir
  check_name "$new"
  from="$(app_path "$old")"; to="$(app_path "$new")"
  is_ours "$from" || die "no launcher made by this tool at '$from'"
  [ "$from" != "$to" ] || die "the new name is the same as the old one"
  [ ! -e "$to" ] || [ "$(printf '%s' "$old" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "$new" | tr '[:upper:]' '[:lower:]')" ] ||
    die "'$to' already exists"
  IFS=$'\t' read -r style color < <(icon_settings "$from" "$old"; printf '\n')
  dir="$(launcher_dir "$from" || true)"
  local lsreg=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
  [ -x "$lsreg" ] && "$lsreg" -u "$from" >/dev/null 2>&1 || true
  mv "$from" "$to.tmp-rename" && mv "$to.tmp-rename" "$to"   # two steps, so a change of case also works
  write_plist "$to" "$new" "$style" "$color"
  [ "$style" = image ] || draw_icon "$to" "$new" "$style" "$color"
  refresh_app "$to"
  say "Renamed  $from"
  say "     to  $to"
  say "Account  ${dir/#$HOME/~} (unchanged, so its sign-in and chats are kept)"
  say "If the old launcher was in the Dock, drag the new one there."
}

launchers() { # prints one launcher path per line
  local a
  for a in "$APPS_DIR"/Claude\ *.app; do
    is_ours "$a" && printf '%s\n' "$a"
  done
  return 0
}

cmd_list() {
  local found=0 broken=0 a name dir state
  if [ "${1:-}" = --names ]; then # one NAME per line, for scripts and the Claude Multi Desktop app
    while IFS= read -r a; do [ -z "$a" ] || { a="$(basename "$a" .app)"; say "${a#Claude }"; }; done < <(launchers)
    return 0
  fi
  printf '%-22s %-6s %s\n' "LAUNCHER" "STATE" "ACCOUNT FOLDER"
  while IFS= read -r a; do
    [ -n "$a" ] || continue
    found=1
    name="$(basename "$a" .app)"; dir="$(launcher_dir "$a" || true)"
    if is_open "$dir"; then state="open"
    elif ! is_claude "$(launcher_target "$a" || true)"; then state="broken"; broken=1
    else state="-"; fi
    printf '%-22s %-6s %s\n' "$name" "$state" "${dir/#$HOME/~}"
  done < <(launchers)
  [ "$found" = 1 ] || say "(no launchers yet: claude-multi-desktop add Work)"
  [ "$broken" = 0 ] || say "A broken launcher opens a Claude.app that is no longer there. Repair it: claude-multi-desktop doctor --fix"
}

cmd_open() {
  [ $# -ge 1 ] || die "usage: claude-multi-desktop open NAME"
  local app; app="$(app_path "$1")"
  [ -d "$app" ] || die "no launcher named '$1' (see: claude-multi-desktop list)"
  open "$app"
}

# Ask Claude in one account, several, or every account to quit, as Cmd-Q does, and wait until each has closed.
# Quit every account before updating Claude Desktop: the update may not install while another account is open.
cmd_quit() {
  local all=0 names="" n a targets="" label dir pids every="" rows="" alive p left closed=0 stuck=0
  local secs="${CMD_QUIT_WAIT:-20}"
  [[ "$secs" =~ ^[0-9]+$ ]] || die "CMD_QUIT_WAIT must be a number of seconds"
  while [ $# -gt 0 ]; do
    case "$1" in
      --all|-a) all=1 ;;
      -*) die "unknown option: $1" ;;
      *) names+="$1"$'\n' ;;
    esac
    shift
  done
  if [ "$all" = 1 ] && [ -z "$names" ]; then
    while IFS= read -r a; do
      [ -n "$a" ] || continue
      targets+="$(basename "$a" .app)"$'\t'"$(launcher_dir "$a" || true)"$'\n'
    done < <(launchers)
    # Claude opened the normal way uses the default folder, whether or not a launcher points at it.
    cut -f2 <<< "$targets" | grep -qxF -- "$SUPPORT/Claude" || targets+="Claude (default account)"$'\t'"$SUPPORT/Claude"$'\n'
  elif [ "$all" = 0 ] && [ -n "$names" ]; then
    while IFS= read -r n; do
      [ -n "$n" ] || continue
      a="$(app_path "$n")"
      is_ours "$a" || die "no launcher named '$n' (see: claude-multi-desktop list)"
      targets+="Claude $n"$'\t'"$(launcher_dir "$a" || true)"$'\n'
    done <<< "$names"
  else
    die "usage: claude-multi-desktop quit NAME...   or   claude-multi-desktop quit --all"
  fi

  # SIGTERM makes Claude quit the way Cmd-Q does: it saves its state and closes its windows.
  while IFS=$'\t' read -r label dir; do
    [ -n "$label" ] || continue
    pids=""; [ -z "$dir" ] || pids="$(account_pids "$dir" | tr '\n' ' ')"
    # shellcheck disable=SC2086  # one argument per PID
    [ -z "${pids// /}" ] || kill -TERM $pids 2>/dev/null || true
    rows+="$label"$'\t'"$pids"$'\n'; every+=" $pids"
  done <<< "$targets"
  left=$((secs * 10))
  while [ "$left" -gt 0 ] && [ -n "$(still_running "$every")" ]; do sleep 0.1; left=$((left - 1)); done

  alive=" $(still_running "$every" | tr '\n' ' ') "
  while IFS=$'\t' read -r label pids; do
    [ -n "$label" ] || continue
    if [ -z "${pids// /}" ]; then [ "$all" = 1 ] || say "Not open $label"; continue; fi
    n=0; for p in $pids; do [[ "$alive" != *" $p "* ]] || n=1; done
    if [ "$n" = 1 ]; then stuck=1; say "Running  $label: still open after ${secs}s"
    else closed=1; say "Quit     $label"; fi
  done <<< "$rows"
  [ "$all" = 0 ] || [ "$closed" = 1 ] || [ "$stuck" = 1 ] || say "No Claude window was open."
  [ "$stuck" = 0 ] || die "a window may be asking you something (unsaved work, a running task); answer it and run quit again, or force it with Option-Command-Esc"
}

report_line() { printf '  %-7s %s\n' "$1" "$2"; }

# Check every launcher and what it relies on. With --fix, repair what is safe to repair: a launcher whose Claude.app
# has moved is pointed at the Claude.app found now, a launcher that cannot run is made runnable, a missing icon is
# drawn again. Account folders (sign-ins and chats) are never changed.
cmd_doctor() {
  local fix=0
  case "${1:-}" in --fix) fix=1 ;; "") ;; *) die "usage: claude-multi-desktop doctor [--fix]" ;; esac
  local claude="" problems=0 fixable=0 fixed=0 a name short dir expr target other style color issues dirs="" d n

  if claude="$(find_claude)"; then report_line ok "Claude.app at $claude"
  else
    claude=""; problems=$((problems + 1))
    report_line PROBLEM "Claude.app not found in /Applications or ~/Applications (set CLAUDE_APP=/path/to/Claude.app)"
  fi
  if [ -d "$CLAUDE_HOME" ]; then report_line ok "Claude Code settings at ${CLAUDE_HOME/#$HOME/~}, shared by every account"
  else report_line note "no ${CLAUDE_HOME/#$HOME/~} yet; Claude Code makes it the first time it runs"; fi

  while IFS= read -r a; do
    [ -n "$a" ] || continue
    name="$(basename "$a" .app)"; short="${name#Claude }"; issues=0
    expr="$(launcher_dir_expr "$a" || true)"; dir="${expr/\$HOME/$HOME}"; target="$(launcher_target "$a" || true)"
    if [ -z "$expr" ] || [ -z "$target" ]; then
      problems=$((problems + 1))
      report_line PROBLEM "$name: the launcher is damaged; remove it and add it again (its account folder is kept)"
      continue
    fi
    if [ ! -x "$a/Contents/MacOS/launcher" ]; then
      issues=1
      if [ "$fix" = 1 ]; then
        chmod +x "$a/Contents/MacOS/launcher"; fixed=$((fixed + 1))
        report_line fixed "$name: the launcher was not allowed to run; now it is"
      else problems=$((problems + 1)); fixable=1; report_line PROBLEM "$name: the launcher is not allowed to run"; fi
    fi
    if ! is_claude "$target"; then
      issues=1
      if [ "$fix" = 1 ] && [ -n "$claude" ]; then
        write_launcher "$a" "$claude" "$expr"; refresh_app "$a"; fixed=$((fixed + 1))
        report_line fixed "$name: opened $target, which is gone; now opens $claude"
      else
        problems=$((problems + 1)); [ -z "$claude" ] || fixable=1
        report_line PROBLEM "$name: opens $target, which is not there"
      fi
    fi
    other="$(awk -F'\t' -v d="$dir" '$1 == d { print $2; exit }' <<< "$dirs")"
    if [ -n "$other" ]; then
      issues=1; problems=$((problems + 1))
      report_line PROBLEM "$name and $other open the same account; remove one of them"
    fi
    dirs+="$dir"$'\t'"$name"$'\n'
    [ "$issues" = 1 ] || report_line ok "$name opens ${dir/#$HOME/~}"
    if is_claude "$target" && [ -n "$claude" ] && [ "$target" != "$claude" ]; then
      report_line note "$name starts $target, not $claude"
    fi
    if [ ! -d "$dir" ]; then report_line note "$name has not been opened yet; its folder is made the first time it opens"; fi
    if [ ! -s "$a/Contents/Resources/icon.icns" ]; then
      IFS=$'\t' read -r style color < <(icon_settings "$a" "$short"; printf '\n')
      if [ "$style" = image ]; then
        report_line note "$name has no icon; give it one: claude-multi-desktop icon \"$short\" --icon /path/to/picture"
      elif [ "$fix" = 1 ]; then
        mkdir -p "$a/Contents/Resources"
        if draw_icon "$a" "$short" "$style" "$color" >/dev/null && [ -s "$a/Contents/Resources/icon.icns" ]; then
          refresh_app "$a"; fixed=$((fixed + 1)); report_line fixed "$name: its icon was missing and is drawn again"
        else report_line note "$name has no icon and none could be drawn; the launcher works without one"; fi
      else report_line note "$name has no icon (doctor --fix draws it again)"; fi
    fi
  done < <(launchers)

  # Folders whose launcher was removed still hold a sign-in and chats; adding the launcher again brings them back.
  for d in "$SUPPORT"/Claude-*; do
    [ -d "$d" ] || continue
    n="${d#"$SUPPORT/Claude-"}"
    { [[ "$n" =~ ^[A-Za-z0-9][A-Za-z0-9\ _-]{0,29}$ ]] && [[ ! "$n" =~ [-\ ]?3[pP]$ ]]; } || continue
    if cut -f1 <<< "$dirs" | grep -qxF -- "$d"; then continue; fi
    if [ -e "$(app_path "$n")" ]; then report_line note "${d/#$HOME/~} keeps a sign-in and chats but no launcher opens it"
    else report_line note "${d/#$HOME/~} keeps a sign-in and chats but has no launcher; bring it back: claude-multi-desktop add \"$n\""; fi
  done

  say ""
  if [ "$problems" -gt 0 ]; then
    say "$problems problem(s) found."
    [ "$fixable" = 0 ] || say "Repair what can be repaired: claude-multi-desktop doctor --fix"
    return 1
  fi
  if [ "$fixed" -gt 0 ]; then say "Fixed $fixed problem(s); nothing else to fix."; else say "No problems found."; fi
}

cmd_remove() {
  local name="" del=0 yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --delete-data) del=1 ;;
      --yes|-y) yes=1 ;;
      -*) die "unknown option: $1" ;;
      *) name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || die "usage: claude-multi-desktop remove NAME [--delete-data]"
  local app dir; app="$(app_path "$name")"
  is_ours "$app" || die "no launcher made by this tool at '$app'"
  dir="$(launcher_dir "$app" || true)"
  rm -rf "$app"
  say "Removed  $app"
  [ "$del" = 1 ] || { say "Kept the account folder $dir (sign-in and chats). Add --delete-data to delete it."; return 0; }
  [ "$dir" != "$SUPPORT/Claude" ] || die "refusing to delete your default Claude folder"
  [[ "$dir" == "$SUPPORT/Claude-"* ]] || die "refusing to delete '$dir': not a folder this tool creates"
  if is_open "$dir"; then die "that account is still open; quit its window and run remove again"; fi
  if [ "$yes" != 1 ]; then
    printf 'Delete %s (sign-in and chats of "%s")? Type the name to confirm: ' "$dir" "$name"
    local reply; read -r reply
    [ "$reply" = "$name" ] || die "not deleted"
  fi
  [ -d "$dir" ] || { say "Nothing to delete at $dir"; return 0; }
  rm -rf "$dir"
  say "Deleted  $dir"
}

# Which account folder a Claude Code session started from (Claude Desktop records its sessions there).
profile_of() {
  local host="${1#local_}" d label
  [ -n "$host" ] || { printf 'terminal'; return; }
  for d in "$SUPPORT/Claude" "$SUPPORT"/Claude-*; do
    [ -d "$d/claude-code-sessions" ] || continue
    if grep -rqsF -- "$host" "$d/claude-code-sessions"; then
      label="$(basename "$d")"; label="${label#Claude-}"; [ "$label" = "Claude" ] && label="default"
      printf '%s' "$label"; return
    fi
  done
  printf '?'
}

cmd_peers() {
  local dir="$CLAUDE_HOME/sessions" files=() f pid
  [ -d "$dir" ] || die "no Claude Code sessions folder at $dir"
  for f in "$dir"/*.json; do
    [ -e "$f" ] || continue
    pid="$(basename "$f" .json)"
    [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null && files+=("$f")
  done
  if [ ${#files[@]} -eq 0 ]; then say "No Claude Code sessions are running."; return 0; fi
  printf '%-14s %-6s %s\n' "ACCOUNT" "STATUS" "SESSION"
  local host status name
  while IFS=$'\t' read -r host status name; do
    printf '%-14s %-6s %s\n' "$(profile_of "$host")" "${status:--}" "${name:-(unnamed)}"
  done < <(osascript -l JavaScript - "${files[@]}" 2>/dev/null <<'JXA'
ObjC.import('Foundation');
function run(argv) {
  const rows = [];
  for (const p of argv) {
    try {
      const d = JSON.parse($.NSString.stringWithContentsOfFileEncodingError(p, $.NSUTF8StringEncoding, null).js);
      const clean = (v) => String(v || '').replace(/[\t\n]/g, ' ');
      rows.push([clean(d.hostSessionId), clean(d.status), clean(d.name)].join('\t'));
    } catch (e) {}
  }
  return rows.join('\n');
}
JXA
  ) | sort -s -k1,1
  say ""
  say "Sessions in different accounts can message each other: ask Claude to list the other sessions and send one a message."
}

main() {
  [ "$(uname -s)" = "Darwin" ] || die "Claude Desktop launchers need macOS"
  local cmd="${1:-help}"; [ $# -gt 0 ] && shift
  case "$cmd" in
    add) cmd_add "$@" ;;
    list|ls) cmd_list "$@" ;;
    icon) cmd_icon "$@" ;;
    rename|mv) cmd_rename "$@" ;;
    open) cmd_open "$@" ;;
    quit) cmd_quit "$@" ;;
    doctor) cmd_doctor "$@" ;;
    peers) cmd_peers ;;
    remove|rm) cmd_remove "$@" ;;
    version|--version|-v) say "claude-multi-desktop $VERSION" ;;
    help|--help|-h) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
